# Copy to .env. Never commit real credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
UPDATE_INTERVAL=30
TOTAL_AGENTS=7

# Generate a long random value locally; required for emergency-stop endpoint.
KILL_SWITCH_TOKEN=replace-with-a-long-random-secret

# Optional integrations — keep blank until configured securely.
OPENAI_API_KEY=
MT5_ACCOUNT_LOGIN=
MT5_ACCOUNT_PASSWORD=
MT5_ACCOUNT_SERVER=

# Optional read-only market data. Practice endpoint is the default.
OANDA_API_URL=https://api-fxpractice.oanda.com
